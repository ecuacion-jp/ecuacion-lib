<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>ecuacion-lib-bom</artifactId>
	<name>${project.artifactId}</name>
	<packaging>pom</packaging>
	<parent>
		<groupId>jp.ecuacion.lib</groupId>
		<artifactId>ecuacion-lib-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../</relativePath>
	</parent>

	<!--
		Version pins for external libraries that ecuacion-lib-core / ecuacion-lib-validation (and
		other non-ecuacion-lib modules such as ecuacion-util-excel-table) depend on directly
		without specifying a version. Kept separate from ecuacion-lib-dependencies: modules that
		use ecuacion-lib-dependencies as their actual <parent> (e.g. ecuacion-splib-dependencies,
		for its strict checkstyle/spotbugs/NullAway tooling) would otherwise also inherit these
		library version pins via that <parent> chain and silently override the versions a
		consuming Spring Boot project would get from spring-boot-dependencies. This pom is
		imported directly (via dependencyManagement import) only by the modules that actually
		need it; ecuacion-lib-dependencies itself never imports it.
	-->
	<properties>
		<jakarta.servlet.jakarta.servlet-api.version>6.1.0</jakarta.servlet.jakarta.servlet-api.version>
		<jakarta.mail.jakarta.mail-api.version>2.1.5</jakarta.mail.jakarta.mail-api.version>
		<!-- jakarta mail implementation (used by MailUtil) -->
		<org.eclipse.angus.angus-mail.version>2.0.5</org.eclipse.angus.angus-mail.version>
		<org.slf4j.slf4j-api.version>2.0.18</org.slf4j.slf4j-api.version>
		<tools.jackson.core.jackson-databind.version>3.2.1</tools.jackson.core.jackson-databind.version>
		<!-- jakarta-el -->
		<org.glassfish.jakarta.el.version>4.0.2</org.glassfish.jakarta.el.version>
		<!-- jakarta validation -->
		<jakarta.validation.jakarta.validation-api.version>3.1.1</jakarta.validation.jakarta.validation-api.version>
		<org.hibernate.validator.hibernate-validator.version>9.1.3.Final</org.hibernate.validator.hibernate-validator.version>
		<!-- apache commons -->
		<org.apache.commons.commons-lang3.version>3.20.0</org.apache.commons.commons-lang3.version>
	</properties>

	<dependencyManagement>
		<dependencies>

			<dependency>
				<groupId>jakarta.servlet</groupId>
				<artifactId>jakarta.servlet-api</artifactId>
				<version>${jakarta.servlet.jakarta.servlet-api.version}</version>
			</dependency>
			<dependency>
				<groupId>jakarta.mail</groupId>
				<artifactId>jakarta.mail-api</artifactId>
				<version>${jakarta.mail.jakarta.mail-api.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.angus</groupId>
				<artifactId>angus-mail</artifactId>
				<version>${org.eclipse.angus.angus-mail.version}</version>
			</dependency>
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>${org.slf4j.slf4j-api.version}</version>
			</dependency>
			<dependency>
				<groupId>tools.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${tools.jackson.core.jackson-databind.version}</version>
			</dependency>
			<dependency>
				<groupId>org.glassfish</groupId>
				<artifactId>jakarta.el</artifactId>
				<version>${org.glassfish.jakarta.el.version}</version>
			</dependency>
			<dependency>
				<groupId>jakarta.validation</groupId>
				<artifactId>jakarta.validation-api</artifactId>
				<version>${jakarta.validation.jakarta.validation-api.version}</version>
			</dependency>
			<dependency>
				<groupId>org.hibernate.validator</groupId>
				<artifactId>hibernate-validator</artifactId>
				<version>${org.hibernate.validator.hibernate-validator.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>${org.apache.commons.commons-lang3.version}</version>
			</dependency>

		</dependencies>
	</dependencyManagement>

</project>
