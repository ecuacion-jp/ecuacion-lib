<FindBugsFilter
  xmlns="https://github.com/spotbugs/filter/3.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!--
    Jakarta Validation validators store annotation parameters in instance fields that are set in
    initialize() and read in isValid(). SpotBugs cannot trace this lifecycle and incorrectly
    reports them as unused (UUF_UNUSED_FIELD).
  -->
  <Match>
    <Bug pattern="UUF_UNUSED_FIELD" />
    <Class name="~jp\.ecuacion\.lib\.validation\.constraints\..*Validator" />
  </Match>

  <!--
    initialize()'s annotation parameter and isValid()'s ConstraintValidatorContext parameter
    are intentionally annotated @Nullable even though never null at runtime, to satisfy
    Eclipse null analysis when overriding jakarta.validation.ConstraintValidator's unannotated
    methods; see the package-info.java note in jp.ecuacion.lib.validation.constraints.
    SpotBugs (as of 4.10.x) flags this as a NonNull-contract violation, which is a false
    positive for this documented, cross-tool compatibility trade-off.
  -->
  <Match>
    <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE" />
    <Class name="~jp\.ecuacion\.lib\.validation\.constraints\..*Validator" />
  </Match>

</FindBugsFilter>
