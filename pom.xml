<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>jp.ecuacion.lib</groupId>
	<artifactId>ecuacion-lib-parent</artifactId>
	<packaging>pom</packaging>
	<version>0.0.1-SNAPSHOT</version>
	<name>${project.artifactId}</name>
	<description>Jakarta Validation extension library providing conditional validators, multi-field validators, and business-friendly validation messages.</description>
	<url>https://github.com/ecuacion-jp/ecuacion-lib</url>
	<organization>
		<name>ecuacion.jp</name>
	</organization>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>ecuacion.jp</name>
			<email>info@ecuacion.jp</email>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/ecuacion-jp/ecuacion-lib.git</connection>
		<developerConnection>scm:git:https://github.com/ecuacion-jp/ecuacion-lib.git</developerConnection>
		<url>https://github.com/ecuacion-jp/ecuacion-lib</url>
	</scm>

	<properties>
		<java.version>21</java.version>
		<!-- maven-compiler-plugin referred properties (no need to plugin definition) -->
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<maven.compiler.showDeprecation>true</maven.compiler.showDeprecation>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<ecuacion-lib.version>0.0.1-SNAPSHOT</ecuacion-lib.version>

		<!--                 -->
		<!-- module versions -->
		<!--                 -->

		<!--
			When you select this pom.xml as a 'parent' project, versions below are referred from your projects.
			But you can still override the version by setting the property with the same key if you want.
		-->

		<!-- plugin module versions -->
		<org.apache.maven.plugins.maven-compiler-plugin.version>3.15.0</org.apache.maven.plugins.maven-compiler-plugin.version>
		<org.apache.maven.plugins.maven-resources-plugin.version>3.5.0</org.apache.maven.plugins.maven-resources-plugin.version>
		<!-- surefire -->
		<org.apache.maven.plugins.maven-surefire-plugin.version>3.5.6</org.apache.maven.plugins.maven-surefire-plugin.version>
		<!-- gpg -->
		<org.apache.maven.plugins.maven-gpg-plugin.version>3.2.8</org.apache.maven.plugins.maven-gpg-plugin.version>
		<!-- central publishing -->
		<org.sonatype.central.central-publishing-maven-plugin.version>0.11.0</org.sonatype.central.central-publishing-maven-plugin.version>
		<!-- wagon upload is off by default; enabled only via ecuacion-repository profile -->
		<wagon.skip>true</wagon.skip>

		<!-- properties for ecuacion build: paths and urls -->
		<repository.ecuacion-repo-sftp-root>sftp://maven-repo.ecuacion.jp/home/ytbiz/www/maven-repo.ecuacion.jp/public</repository.ecuacion-repo-sftp-root>
		<repository.ecuacion-repo-http-root>http://maven-repo.ecuacion.jp/public</repository.ecuacion-repo-http-root>
		<remote-location.docs-work>sftp://docs.ecuacion.jp/home/ytbiz/my-data/scripts/work</remote-location.docs-work>
		
	</properties>

	<build>
		<pluginManagement>
			<plugins>

				<!-- maven-resources-plugin (copies/filters resource files; per-module resources /
					delimiters config, e.g. @ delimiters for version files, is set in each module) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>${org.apache.maven.plugins.maven-resources-plugin.version}</version>
				</plugin>

				<!-- maven-compiler-plugin: version pin only. If you declare this plugin
				     yourself, you get a consistent, tested version without specifying one. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${org.apache.maven.plugins.maven-compiler-plugin.version}</version>
				</plugin>

			</plugins>
		</pluginManagement>
	</build>

	<dependencyManagement>
		<dependencies>

			<!-- ecuacion-lib -->
			<dependency>
				<groupId>jp.ecuacion.lib</groupId>
				<artifactId>ecuacion-lib-core</artifactId>
				<version>${ecuacion-lib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.lib</groupId>
				<artifactId>ecuacion-lib-validation</artifactId>
				<version>${ecuacion-lib.version}</version>
			</dependency>
			<dependency>
				<groupId>jp.ecuacion.lib</groupId>
				<artifactId>ecuacion-lib-validation-business-messages</artifactId>
				<version>${ecuacion-lib.version}</version>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<modules>
		<module>ecuacion-lib-dependencies</module>
		<module>ecuacion-lib-core</module>
		<module>ecuacion-lib-validation</module>
		<module>ecuacion-lib-validation-business-messages</module>
	</modules>

	<profiles>

		<!-- This profile is used in github actions to deploy modules to the release page on github.
		     Used for ecuacion tools (ecuacion-tools, ecuacion-tool-code-generator, ...) and applications. -->
		<profile>
			<id>github-release-page</id>
		</profile>

		<!-- This profile is used in github actions to deploy to maven central.
		     Used for ecuacion libraries (ecuacion-lib, ecuacion-utils, ...). -->
		<profile>
			<id>maven-central</id>
			<build>
				<plugins>

					<!-- maven-gpg-plugin (signs artifacts for Maven Central) -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${org.apache.maven.plugins.maven-gpg-plugin.version}</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
					</plugin>

					<!-- central-publishing-maven-plugin (publishes to Maven Central) -->
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${org.sonatype.central.central-publishing-maven-plugin.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>false</autoPublish>
							<deploymentName>ecuacion-lib-${project.version}</deploymentName>
						</configuration>
					</plugin>
 
				</plugins>
			</build>
		</profile>

		<!-- The profile for ecuacion build -->
		<profile>
			<id>ecuacion-repository</id>
			<properties>
				<mvn.prof-id>ecuacion-repository</mvn.prof-id>
				<wagon.skip>false</wagon.skip>
			</properties>
			<repositories>
				<repository>
					<id>ecuacion-repo-http</id>
					<name>ecuacion-repo-http</name>
					<url>https://maven-repo.ecuacion.jp/public</url>
				</repository>
			</repositories>
			<distributionManagement>
				<!-- Not accessible to general users. Only available from the build environment. -->
				<repository>
					<id>ecuacion-repo-sftp</id>
					<name>ecuacion maven repository</name>
					<url>${repository.ecuacion-repo-sftp-root}</url>
				</repository>
			</distributionManagement>
		</profile>

	</profiles>
</project>
